+            depth = owner.grid.Depth * 2 - 1;
+            int count = width * depth;
+            points = new Vector3[count]; edges = new byte[count]; costs = new float[count];
+            parents = new int[count]; closed = new bool[count];
+            for (int z = 0; z < depth; z++)
