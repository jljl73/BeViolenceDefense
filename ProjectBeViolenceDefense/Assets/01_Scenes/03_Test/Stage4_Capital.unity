  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4058488f68ed92e43883b1da4cb217df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueHudTester
  dialogue: {fileID: 764363402}
  lines:
  - speaker: Mage
    expression: 0
    text: Two armies are marching on the core...
  - speaker: Mage
    expression: 3
    text: 'I can''t fight either of them.

      Not even a little.'
  - speaker: Mage
    expression: 2
    text: Wait. They hate each other more than they hate me?
  - speaker: Mage
    expression: 1
    text: If I can make them meet, they will wear each other down!
  - speaker: Mage
    expression: 5
    text: ...but what if they all come for me instead?
  - speaker: Mage
    expression: 6
    text: Th-that is NOT part of the plan!!
