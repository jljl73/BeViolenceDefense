# Unity 프로젝트가 저장소 루트가 아닌 ProjectBeViolenceDefense/ 하위에 있으므로
# 루트 기준(/...) 패턴은 모두 /ProjectBeViolenceDefense/ 로 시작하도록 수정함
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/ProjectBeViolenceDefense/[Ll]ibrary/
/ProjectBeViolenceDefense/[Tt]emp/
/ProjectBeViolenceDefense/[Oo]bj/
/ProjectBeViolenceDefense/[Bb]uild/
/ProjectBeViolenceDefense/[Bb]uilds/
/ProjectBeViolenceDefense/[Ll]ogs/
/ProjectBeViolenceDefense/[Uu]ser[Ss]ettings/
*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
/ProjectBeViolenceDefense/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
/ProjectBeViolenceDefense/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/ProjectBeViolenceDefense/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
/ProjectBeViolenceDefense/*_BackUpThisFolder_ButDontShipItWithYourGame/
/ProjectBeViolenceDefense/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender generated backup files
/ProjectBeViolenceDefense/[Aa]ssets/**/*.blend1
/ProjectBeViolenceDefense/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
/ProjectBeViolenceDefense/[Aa]ssets/**/TDImportCache/
/ProjectBeViolenceDefense/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
/ProjectBeViolenceDefense/[Aa]ssets/_Recovery/
/ProjectBeViolenceDefense/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/ProjectBeViolenceDefense/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
/ProjectBeViolenceDefense/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
/ProjectBeViolenceDefense/[Aa]ssets/AddressableAssetsData/link.xml
/ProjectBeViolenceDefense/[Aa]ssets/AddressableAssetsData/link.xml.meta
/ProjectBeViolenceDefense/[Aa]ssets/Addressables_Temp/
/ProjectBeViolenceDefense/[Aa]ssets/Addressables_Temp.meta
/ProjectBeViolenceDefense/[Aa]ssets/StreamingAssets/aa/
/ProjectBeViolenceDefense/[Aa]ssets/StreamingAssets/aa.meta
/ProjectBeViolenceDefense/ServerData/

# EDM4U generated files
/ProjectBeViolenceDefense/[Aa]ssets/GeneratedLocalRepo/
/ProjectBeViolenceDefense/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
/ProjectBeViolenceDefense/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
/ProjectBeViolenceDefense/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
/ProjectBeViolenceDefense/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/ProjectBeViolenceDefense/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/ProjectBeViolenceDefense/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/ProjectBeViolenceDefense/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
/ProjectBeViolenceDefense/[Aa]ssets/InitTestScene*.unity
/ProjectBeViolenceDefense/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
/ProjectBeViolenceDefense/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/ProjectBeViolenceDefense/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/ProjectBeViolenceDefense/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/ProjectBeViolenceDefense/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
/ProjectBeViolenceDefense/UIElementsSchema/

# Auto-generated cache in Assets folder
/ProjectBeViolenceDefense/[Aa]ssets/[Ss]ceneDependencyCache*

# ===== 추가: macOS =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===== 추가: Windows =====
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== 추가: IDE =====
.idea/
*.swp
*~

# ===== Art pipeline: only finished models (in the Unity project) are tracked =====
# Work folders: concepts, turnarounds, Meshy/Codex intermediates, mockups, generator output, local tools
Art3D/
ArtDirection/
Tools/

# Unity: test scenes and animation preview controllers built for checking units
ProjectBeViolenceDefense/Assets/Scenes/Test_*
ProjectBeViolenceDefense/Assets/Art/**/Preview/
ProjectBeViolenceDefense/Assets/Art/**/Preview.meta

# Codex art job leftovers (wherever they land)
_codex_*.txt
_deps/
_generated*.png
